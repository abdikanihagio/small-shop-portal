# Copy to .env (next to package.json) to change these. Everything is optional.
# Real environment variables always win over this file. Never commit your .env.

# Port the portal listens on.
PORT=3000

# Leave empty to accept connections from the shop network (tablets at the till).
# Set to 127.0.0.1 to allow this computer only.
HOST=

# PostgreSQL. Two accounts, both with long random passwords; keep this file private.
# The portal's own account: owns the shop's tables, no superuser rights (made by scripts/db-app-account.js).
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=shop_app
PGPASSWORD=
PGDATABASE=shop
# The administrator account Docker creates (docker-compose.yml); used only by scripts and tests.
PG_ADMIN_USER=shop
PG_ADMIN_PASSWORD=
# Or one connection string instead (it wins over the PG* settings above):
DATABASE_URL=

# Where the HTTPS certificate files live. Default: ./data
DATA_DIR=

# Where backups are kept. Default: DATA_DIR/backups. Another disk (or a synced cloud folder) is safer.
BACKUP_DIR=

# Online behind a hosting service's HTTPS (Railway, Render…): set to 1. The portal then reads the
# visitor's address from the proxy, makes cookies HTTPS-only and redirects http:// to https://.
# Leave empty when the portal runs in the shop.
TRUST_PROXY=

# The shop's time zone for dates and "today" (e.g. Africa/Nairobi). Default: this computer's.
# Set it on a hosting service, whose servers usually run on UTC.
TZ=

# HTTPS. By default the files made by scripts\create-https-cert.ps1 in DATA_DIR\tls are used.
# Either a .pfx file (+ its passphrase) ...
TLS_PFX=
TLS_PASSPHRASE=
# ... or a certificate and key in PEM format.
TLS_CERT=
TLS_KEY=
