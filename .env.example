# Copy to .env (next to package.json) to change these. Everything is optional.
# Real environment variables always win over this file. Never commit your .env.

# Port the portal listens on.
PORT=3000

# Leave empty to accept connections from the shop network (tablets at the till).
# Set to 127.0.0.1 to allow this computer only.
HOST=

# Where the database (shop.db) and HTTPS certificate files live. Default: ./data
DATA_DIR=

# HTTPS. By default the files made by scripts\create-https-cert.ps1 in DATA_DIR\tls are used.
# Either a .pfx file (+ its passphrase) ...
TLS_PFX=
TLS_PASSPHRASE=
# ... or a certificate and key in PEM format.
TLS_CERT=
TLS_KEY=
